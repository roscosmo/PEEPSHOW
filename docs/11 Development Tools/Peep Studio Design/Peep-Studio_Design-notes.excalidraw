      "index": "b9dr",
      "roundness": null,
      "seed": 1126961097,
      "version": 1502,
      "versionNonce": 452904045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788664890144,
      "link": null,
      "locked": false,
      "text": "The menu prefab generates the required internal variables to assign to a cursor object,\nas well as the state logic for the transition between menu selection states (eg, vertical\nmenu in this example would wire up the logic for the joystick up/down actions to\ntransition between menu item selection states, and track what is selected to launch\nthe correct following scene). The Inpector would allow selecting cursor object(s) and \nthe author would only have to select their positions per-state. ",
      "fontSize": 37.502817418253656,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The menu prefab generates the required internal variables to assign to a cursor object,\nas well as the state logic for the transition between menu selection states (eg, vertical\nmenu in this example would wire up the logic for the joystick up/down actions to\ntransition between menu item selection states, and track what is selected to launch\nthe correct following scene). The Inpector would allow selecting cursor object(s) and \nthe author would only have to select their positions per-state. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
