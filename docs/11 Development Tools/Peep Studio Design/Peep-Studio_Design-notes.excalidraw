      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "lXrY4A0eR47mYrXs4qzu7",
      "index": "b9dwV",
      "roundness": null,
      "seed": 2123290211,
      "version": 2331,
      "versionNonce": 1273365133,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788664890144,
      "link": null,
      "locked": false,
      "text": "Depending on the options selected for the menu, various internal logic states and \nvariables woule be configured. For instance, in this example vertical menu, \nif the 'menu loop-around' option is enabled, it would enable the joystick down from from \nMenu item 3 to Menu item 1 and vice versa with joystick up; if no loop-around is desired\nthen those paths are disabled and the menu has a strict top and bottom. Same principle\nfor a horizontal menu, with up/down replaced with left/right. ",
      "fontSize": 37.502817418253656,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Depending on the options selected for the menu, various internal logic states and \nvariables woule be configured. For instance, in this example vertical menu, \nif the 'menu loop-around' option is enabled, it would enable the joystick down from from \nMenu item 3 to Menu item 1 and vice versa with joystick up; if no loop-around is desired\nthen those paths are disabled and the menu has a strict top and bottom. Same principle\nfor a horizontal menu, with up/down replaced with left/right. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
