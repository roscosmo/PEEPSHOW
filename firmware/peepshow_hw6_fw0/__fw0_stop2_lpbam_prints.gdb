printf "display fill/clock/link/start = 0x%x / 0x%x / 0x%x / 0x%x\n", $ow->display_lpbam_fill_status, $ow->display_lpbam_clock_status, $ow->display_lpbam_link_status, $ow->display_lpbam_start_status
