printf "display lpbam spi kernel/dir/presc/ssid/cfg1/cfg2 = %u / 0x%x / 0x%x / 0x%x / 0x%x / 0x%x\n", $ow->display_lpbam_spi_kernel_hz, $ow->display_lpbam_spi_init_direction, $ow->display_lpbam_spi_init_prescaler, $ow->display_lpbam_spi_init_ss_idleness, $ow->display_lpbam_spi_cfg1_after_init, $ow->display_lpbam_spi_cfg2_after_init
