printf "runtime epoch / RTC arm count/status/clock/counter = %u / %u / 0x%x / 0x%x / %u\n", g_ps_hw6_rtos_probe.runtime_interaction_epoch, g_ps_hw6_rtos_probe.runtime_interaction_rtc_arm_count, g_ps_hw6_rtos_probe.runtime_interaction_rtc_arm_status, g_ps_hw6_rtos_probe.runtime_interaction_rtc_clock, g_ps_hw6_rtos_probe.runtime_interaction_rtc_counter
printf "runtime RTC remaining/elapsed/expire/command = %u / %u / %u / 0x%x\n", g_ps_hw6_rtos_probe.runtime_interaction_rtc_remaining_ticks, g_ps_hw6_rtos_probe.runtime_interaction_rtc_elapsed_ticks, g_ps_hw6_rtos_probe.runtime_interaction_rtc_expire_count, g_ps_hw6_rtos_probe.runtime_interaction_rtc_command_status
printf "cue active/show/clear/deadline = %u / %u / %u / %u\n", g_ps_hw6_rtos_probe.runtime_interaction_cue_active, g_ps_hw6_rtos_probe.runtime_interaction_cue_show_count, g_ps_hw6_rtos_probe.runtime_interaction_cue_clear_count, g_ps_hw6_rtos_probe.runtime_interaction_cue_deadline_tick
printf "activation active/frame/start/complete/deadline/status = %u / %u / %u / %u / %u / 0x%x\n", g_ps_hw6_rtos_probe.runtime_interaction_activation_active, g_ps_hw6_rtos_probe.runtime_interaction_activation_frame, g_ps_hw6_rtos_probe.runtime_interaction_activation_count, g_ps_hw6_rtos_probe.runtime_interaction_activation_complete_count, g_ps_hw6_rtos_probe.runtime_interaction_activation_deadline_tick, g_ps_hw6_rtos_probe.runtime_interaction_activation_render_status
printf "inactive suppressed/start count/status = %u / %u / 0x%x\n", g_ps_hw6_rtos_probe.runtime_interaction_suppressed_input_count, g_ps_hw6_rtos_probe.runtime_interaction_start_count, g_ps_hw6_rtos_probe.runtime_interaction_start_status
printf "joystick wake allowed/expected pin/wake C/park C = %u / 0x%x / 0x%x / 0x%x\n", g_ps_hw6_rtos_probe.runtime_interaction_joystick_wake_allowed, g_ps_hw6_owner_sm_probe.stop2_expected_wake_pin, g_ps_hw6_owner_sm_probe.stop2_gpio_wake_mask[2], g_ps_hw6_owner_sm_probe.stop2_gpio_park_mask[2]
