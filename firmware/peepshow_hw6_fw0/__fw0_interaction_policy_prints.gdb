set pagination off
printf "--- HW6 package interaction lifecycle ---\n"
printf "api rtos/scene/loader/owner/ui = %u / %u / %u / %u / %u\n", g_ps_hw6_rtos_probe.version, g_ps_scene_runtime_probe.api_version, g_ps_egg_state_loader_probe.api_version, g_ps_hw6_owner_sm_probe.version, g_ps_ui_router_probe.api_version
printf "loader interaction mode/route/meaningful mask = %u / %u / 0x%x\n", g_ps_egg_state_loader_probe.interaction_mode, g_ps_egg_state_loader_probe.inactive_route, g_ps_egg_state_loader_probe.meaningful_input_mask
printf "scene interaction mode/route/meaningful mask = %u / %u / 0x%x\n", g_ps_scene_runtime_probe.descriptor_interaction_mode, g_ps_scene_runtime_probe.descriptor_inactive_route, g_ps_scene_runtime_probe.descriptor_meaningful_input_mask
printf "runtime interaction mode/state/deadline = %u / %u / %u\n", g_ps_hw6_rtos_probe.runtime_interaction_mode, g_ps_hw6_rtos_probe.runtime_interaction_state, g_ps_hw6_rtos_probe.runtime_interaction_deadline_tick
printf "runtime activity refresh/active/inactive = %u / %u / %u\n", g_ps_hw6_rtos_probe.runtime_interaction_activity_refresh_count, g_ps_hw6_rtos_probe.runtime_interaction_active_count, g_ps_hw6_rtos_probe.runtime_interaction_inactive_count
