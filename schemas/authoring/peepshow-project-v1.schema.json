{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peepshow.dev/schema/authoring/peepshow-project-v1.schema.json",
  "title": "PeepShow Authoring Project V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "project_name",
    "package",
    "selected_target_profile",
    "entry_scene",
    "scene_sources",
    "validation"
  ],
  "properties": {
    "settings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sfx_import": {
          "type": "object", "additionalProperties": false,
          "required": ["normalization", "target_peak_dbfs"],
          "properties": {
            "normalization": {"enum": ["none", "peak"]},
            "target_peak_dbfs": {"type": "integer", "minimum": -60, "maximum": 0}
          }
        },
        "runtime_preferences": {
          "type": "object", "additionalProperties": false,
          "required": ["inactivity_timeout_ms"],
          "properties": {
            "inactivity_timeout_ms": {"type": ["integer", "null"], "minimum": 1000, "maximum": 86400000}
          }
        }
      }
    },
    "schema_id": { "const": "peepshow.authoring.project" },
    "schema_version": { "const": 1 },
    "project_id": { "$ref": "#/$defs/stable_id" },
    "project_name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "display_name", "version"],
      "properties": {
        "package_id": { "$ref": "#/$defs/stable_id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "selected_target_profile": { "$ref": "#/$defs/stable_id" },
    "entry_scene": { "$ref": "#/$defs/stable_id" },
    "scene_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_profile", "ruleset_version"],
      "properties": {
        "build_profile": { "enum": ["development", "shipping"] },
        "ruleset_version": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    }
  }
}
