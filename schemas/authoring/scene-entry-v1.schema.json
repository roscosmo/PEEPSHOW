{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peepshow.dev/schema/authoring/scene-entry-v1.schema.json",
  "title": "Explicit fresh scene entry (host only)",
  "type": "object", "additionalProperties": false,
  "required": ["root", "nodes"],
  "properties": {
    "root": {"$ref": "#/$defs/id"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/node"}},
    "layout": {"type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "integer", "minimum": -100000, "maximum": 100000},
                     "y": {"type": "integer", "minimum": -100000, "maximum": 100000}}
    }}
  },
  "$defs": {
    "id": {"$ref": "scoped-variables-v1.schema.json#/$defs/id"},
    "action": {"oneOf": [
      {"$ref": "scoped-variables-v1.schema.json#/$defs/action"},
      {"type": "object", "additionalProperties": false, "required": ["kind", "cue_ref"],
       "properties": {"kind": {"const": "play_sfx"}, "cue_ref": {"$ref": "#/$defs/id"}}}
    ]},
    "node": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "state_ref"],
       "properties": {"node_id": {"$ref": "#/$defs/id"}, "kind": {"const": "state"}, "state_ref": {"$ref": "#/$defs/id"}}},
      {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "actions", "next"],
       "properties": {"node_id": {"$ref": "#/$defs/id"}, "kind": {"const": "actions"}, "next": {"$ref": "#/$defs/id"},
         "actions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/action"}}}},
      {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "branches", "default"],
       "properties": {"node_id": {"$ref": "#/$defs/id"}, "kind": {"const": "decision"}, "default": {"$ref": "#/$defs/id"},
         "branches": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
           "type": "object", "additionalProperties": false, "required": ["guards", "next"],
           "properties": {"next": {"$ref": "#/$defs/id"}, "guards": {
             "type": "array", "minItems": 1, "maxItems": 8,
             "items": {"$ref": "scoped-variables-v1.schema.json#/$defs/guard"}}}
         }}}}
    ]}
  }
}
