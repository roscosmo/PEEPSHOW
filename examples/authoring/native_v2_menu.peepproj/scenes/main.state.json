{
  "schema_id": "peepshow.authoring.state_scene",
  "schema_version": 2,
  "scene_id": "main",
  "display_name": "Main Menu",
  "scene_type": "STATE_SCENE",
  "entry_state": "start",
  "variables": [],
  "input_actions": [
    {
      "action_id": "joy_down_press",
      "logical_source": "JOY_DOWN",
      "event_kind": "press"
    },
    {
      "action_id": "joy_up_press",
      "logical_source": "JOY_UP",
      "event_kind": "press"
    },
    {
      "action_id": "button_a_press",
      "logical_source": "BUTTON_A",
      "event_kind": "press"
    }
  ],
  "scene_exits": [
    {"scene_exit_id":"to_start_game","display_name":"Start Game","target_scene":"start_game"},
    {"scene_exit_id":"to_settings","display_name":"Settings","target_scene":"settings"},
    {"scene_exit_id":"to_credits","display_name":"Credits","target_scene":"credits"}
  ],
  "routes": [
    {
      "route_id": "start_joy_down_press",
      "action_ref": "joy_down_press",
      "from_states": [
        "start"
      ],
      "guards": [],
      "actions": [{"kind":"play_sfx","cue_ref":"menu_select.cue"}],
      "target_state": "settings"
    },
    {
      "route_id": "start_joy_up_press",
      "action_ref": "joy_up_press",
      "from_states": [
        "start"
      ],
      "guards": [],
      "actions": [{"kind":"play_sfx","cue_ref":"menu_select.cue"}],
      "target_state": "credits"
    },
    {
      "route_id": "settings_joy_down_press",
      "action_ref": "joy_down_press",
      "from_states": [
        "settings"
      ],
      "guards": [],
      "actions": [{"kind":"play_sfx","cue_ref":"menu_select.cue"}],
      "target_state": "credits"
    },
    {
      "route_id": "settings_joy_up_press",
      "action_ref": "joy_up_press",
      "from_states": [
        "settings"
      ],
      "guards": [],
      "actions": [{"kind":"play_sfx","cue_ref":"menu_select.cue"}],
      "target_state": "start"
    },
    {
      "route_id": "credits_joy_down_press",
      "action_ref": "joy_down_press",
      "from_states": [
        "credits"
      ],
      "guards": [],
      "actions": [{"kind":"play_sfx","cue_ref":"menu_select.cue"}],
      "target_state": "start"
    },
    {
      "route_id": "credits_joy_up_press",
      "action_ref": "joy_up_press",
      "from_states": [
        "credits"
      ],
      "guards": [],
      "actions": [{"kind":"play_sfx","cue_ref":"menu_select.cue"}],
      "target_state": "settings"
    },
    {
      "route_id":"choose_start","action_ref":"button_a_press","from_states":["start"],"guards":[],"actions":[],
      "scene_exit_ref":"to_start_game","target_scene":"start_game"
    },
    {
      "route_id":"choose_settings","action_ref":"button_a_press","from_states":["settings"],"guards":[],"actions":[],
      "scene_exit_ref":"to_settings","target_scene":"settings"
    },
    {
      "route_id":"choose_credits","action_ref":"button_a_press","from_states":["credits"],"guards":[],"actions":[],
      "scene_exit_ref":"to_credits","target_scene":"credits"
    }
  ],
  "reactive_wait_default": {
    "policy_id": "main_wait_policy",
    "hold_fallback_allowed": true,
    "event_interests": [
      "joy_down_press",
      "joy_up_press",
      "button_a_press",
      "ready_timer"
    ]
  },
  "interaction_policy": {
    "policy_id": "main_interaction",
    "mode": "continuous",
    "meaningful_activity_actions": [
      "joy_down_press",
      "joy_up_press",
      "button_a_press"
    ]
  },
  "objects": [
    {
      "object_id": "menu_border",
      "display_name": "Menu border",
      "kind": "outline_rect",
      "width": 160,
      "height": 136,
      "z_order": 0,
      "layer": "SCENE",
      "defaults": {
        "x": 4,
        "y": 4,
        "visible": true
      }
    },
    {
      "object_id": "menu_divider",
      "display_name": "Title divider",
      "kind": "filled_rect",
      "width": 144,
      "height": 1,
      "z_order": 1,
      "layer": "SCENE",
      "defaults": {
        "x": 12,
        "y": 31,
        "visible": true
      }
    },
    {
      "object_id": "menu_title",
      "display_name": "Menu title",
      "kind": "text",
      "text": "MENU",
      "font_id": "peepshow.system.8x8.basic.v1",
      "scale": 2,
      "alignment": "left",
      "width": 64,
      "height": 16,
      "z_order": 2,
      "layer": "SCENE",
      "defaults": {
        "x": 16,
        "y": 12,
        "visible": true
      }
    },
    {
      "object_id": "start_label",
      "display_name": "Start Game label",
      "kind": "text",
      "text": "Start Game",
      "font_id": "peepshow.system.8x8.basic.v1",
      "scale": 1,
      "alignment": "left",
      "width": 80,
      "height": 8,
      "z_order": 2,
      "layer": "SCENE",
      "defaults": {
        "x": 24,
        "y": 46,
        "visible": true
      }
    },
    {
      "object_id": "settings_label",
      "display_name": "Settings label",
      "kind": "text",
      "text": "Settings",
      "font_id": "peepshow.system.8x8.basic.v1",
      "scale": 1,
      "alignment": "left",
      "width": 64,
      "height": 8,
      "z_order": 2,
      "layer": "SCENE",
      "defaults": {
        "x": 24,
        "y": 78,
        "visible": true
      }
    },
    {
      "object_id": "credits_label",
      "display_name": "Credits label",
      "kind": "text",
      "text": "Credits",
      "font_id": "peepshow.system.8x8.basic.v1",
      "scale": 1,
      "alignment": "left",
      "width": 56,
      "height": 8,
      "z_order": 2,
      "layer": "SCENE",
      "defaults": {
        "x": 24,
        "y": 110,
        "visible": true
      }
    },
    {
      "object_id": "selection_outline",
      "display_name": "Selection outline",
      "kind": "outline_rect",
      "width": 144,
      "height": 24,
      "z_order": 3,
      "layer": "SCENE",
      "defaults": {
        "x": 12,
        "y": 38,
        "visible": true
      }
    },
    {
      "object_id": "continuity_counter",
      "display_name": "Animation continuity",
      "kind": "sprite",
      "width": 8,
      "height": 8,
      "z_order": 4,
      "layer": "SCENE",
      "defaults": {
        "x": 140,
        "y": 16,
        "visible": true,
        "visual_ref": "counter_1.frame"
      },
      "animation_ref": "menu_counter_loop"
    },
    {
      "object_id":"ready_hint","display_name":"Timer reveal","kind":"text","text":"A: OPEN","font_id":"peepshow.system.8x8.basic.v1",
      "scale":1,"alignment":"right","width":64,"height":8,"z_order":4,"layer":"UI",
      "defaults":{"x":92,"y":128,"visible":false}
    }
  ],
  "states": [
    {
      "state_id": "start",
      "display_name": "Start Game",
      "object_overrides": [
        {
          "object_ref": "selection_outline",
          "y": 38
        }
      ]
    },
    {
      "state_id": "settings",
      "display_name": "Settings",
      "object_overrides": [
        {
          "object_ref": "selection_outline",
          "y": 70
        }
      ]
    },
    {
      "state_id": "credits",
      "display_name": "Credits",
      "object_overrides": [
        {
          "object_ref": "selection_outline",
          "y": 102
        }
      ]
    }
  ],
  "event_bindings":[
    {"binding_id":"ready_timer","event_type":"time.scene_elapsed","configuration":{"delay_ms":2000,"start_policy":"scene_entry"}}
  ],
  "event_handlers":[
    {"handler_id":"ready_timer_expired","event_ref":"ready_timer","guards":[],"actions":[{"kind":"object.set_visibility","object_ref":"ready_hint","visible":true}]}
  ]
}
